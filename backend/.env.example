# --- App ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Database ---
DATABASE_URL=postgresql+psycopg2://exec_assistant:exec_assistant@localhost:5432/exec_assistant

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- JIRA Cloud: sign in with Atlassian (recommended) ---
# One-time setup: create an OAuth 2.0 (3LO) app at
# https://developer.atlassian.com/console/myapps/, add the Jira API with the
# read:jira-work and read:jira-user scopes, set the callback URL below, then
# paste the Client ID and Secret here. Users then click "Connect with Atlassian"
# on the Integrations page — no API tokens needed.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/api/jira/oauth/callback
JIRA_OAUTH_SCOPES=read:jira-work read:jira-user offline_access

# --- JIRA Cloud: API token fallback (optional) ---
# Only used when no Atlassian account has been connected via OAuth.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=
# Optional: restrict "my tasks" / "team tasks" queries to a project key
JIRA_PROJECT_KEY=

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-token

# --- SMTP (email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com
SMTP_PASSWORD=
SMTP_FROM="Executive Assistant <you@yourcompany.com>"

# --- Files ---
REPORTS_DIR=./generated_reports

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
